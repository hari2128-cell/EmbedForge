GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2025-01-01
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SESSION_SECRET=
FRONTEND_URL=http://localhost:5173
APP_ENV=development
SUPABASE_STORAGE_BUCKET=embed-forge-materials
# Per-worker outbound connection pool and request protection.
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=40
MAX_CONCURRENT_REQUESTS=120
# Use this with the Render start command in the README.
WEB_CONCURRENCY=2
